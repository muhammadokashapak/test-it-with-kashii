{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://test-it-with-kashii.internal/schemas/finding.schema.json",
  "title": "FindingContract",
  "type": "object",
  "required": [
    "id",
    "project_id",
    "test_run_id",
    "title",
    "description",
    "type",
    "severity",
    "confidence",
    "status",
    "created_at"
  ],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "project_id": { "type": "string", "format": "uuid" },
    "test_run_id": { "type": "string", "format": "uuid" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "type": {
      "type": "string",
      "enum": [
        "FUNCTIONAL",
        "VISUAL",
        "NETWORK",
        "CONSOLE_ERROR",
        "PERFORMANCE",
        "ACCESSIBILITY",
        "SECURITY"
      ]
    },
    "severity": {
      "type": "string",
      "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "status": {
      "type": "string",
      "enum": ["UNVERIFIED", "LIKELY", "CONFIRMED", "FLAKY", "REJECTED", "FIXED"]
    },
    "expected": { "type": "string" },
    "actual": { "type": "string" },
    "reproduction_steps": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evidence_ids": {
      "type": "array",
      "items": { "type": "string", "format": "uuid" }
    },
    "affected_urls": {
      "type": "array",
      "items": { "type": "string" }
    },
    "root_cause_hint": { "type": ["string", "null"] },
    "recommendation": { "type": ["string", "null"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
