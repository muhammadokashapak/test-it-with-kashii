{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://test-it-with-kashii.internal/schemas/action.schema.json",
  "title": "ActionContract",
  "type": "object",
  "required": ["id", "run_id", "type", "target", "status", "started_at"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "run_id": { "type": "string", "format": "uuid" },
    "browser_session_id": { "type": ["string", "null"], "format": "uuid" },
    "scenario_id": { "type": ["string", "null"], "format": "uuid" },
    "sequence_no": { "type": "integer" },
    "type": {
      "type": "string",
      "enum": [
        "navigate",
        "click",
        "type",
        "fill",
        "select",
        "check",
        "uncheck",
        "hover",
        "scroll",
        "press",
        "wait",
        "upload",
        "download"
      ]
    },
    "target": {
      "type": "object",
      "properties": {
        "selector": { "type": "string" },
        "url": { "type": "string" },
        "coordinates": {
          "type": "object",
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" }
          }
        }
      }
    },
    "parameters": { "type": "object" },
    "result": { "type": ["object", "null"] },
    "status": {
      "type": "string",
      "enum": ["PENDING", "RUNNING", "SUCCEEDED", "FAILED", "SKIPPED"]
    },
    "error": {
      "type": ["object", "null"],
      "properties": {
        "message": { "type": "string" },
        "stack": { "type": "string" }
      }
    },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": ["string", "null"], "format": "date-time" }
  }
}
